# LINE webhook secrets. Supply values through Secret Manager or an untracked local .env.
MEDBUDDY_LINE_CHANNEL_SECRET=
MEDBUDDY_LINE_CHANNEL_ACCESS_TOKEN=

# Existing GCP and Vertex configuration. Credentials use Application Default Credentials.
MEDBUDDY_GCP_PROJECT_ID=
MEDBUDDY_VERTEX_ENABLED=true
MEDBUDDY_VERTEX_PROJECT=
MEDBUDDY_VERTEX_LOCATION=global
MEDBUDDY_VERTEX_MODEL=gemini-3.6-flash
