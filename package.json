{
  "name": "medbuddy",
  "private": true,
  "version": "0.0.0",
  "description": "MedBuddy fictional-data-only prototype workspace",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run check:adapter-js && npm run lint && npm run check:boundaries",
    "check:adapter-js": "tsc --project tsconfig.adapter-js.json",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint .",
    "dev": "npm run dev --workspace @medbuddy/web",
    "build": "npm run build --workspace @medbuddy/web",
    "start": "npm run start --workspace @medbuddy/web",
    "test": "vitest run",
    "smoke:line": "vitest run --run line",
    "verify:continuity:memory": "vitest run --run continuity-verification-memory",
    "verify:continuity:emulator": "vitest run --run continuity-verification-firestore",
    "verify:memory:tracer": "vitest run --run memory-tracer",
    "verify:passive-memory:worker": "vitest run --run passive-memory-direct-proof",
    "verify:memory-formation": "vitest run --run memory-formation-direct-proof",
    "verify:memory:acceptance": "vitest run --config vitest.memory-acceptance.config.ts",
    "verify:memory:acceptance:memory": "MEDBUDDY_MEMORY_ACCEPTANCE_IN_MEMORY_ONLY=true vitest run --config vitest.memory-acceptance.config.ts",
    "eval:memory:acceptance": "MEDBUDDY_RUN_MEMORY_ACCEPTANCE_EVAL=true vitest run --run --testTimeout=240000 memory-acceptance-vertex",
    "eval:continuity-family": "MEDBUDDY_RUN_CONTINUITY_FAMILY_EVAL=true vitest run --run --testTimeout=240000 continuity-verification-vertex",
    "verify:continuity:target": "vitest run --run --testTimeout=120000 continuity-verification-target",
    "verify:continuity:cleanup": "node scripts/cleanup-continuity-verification.mjs",
    "test:e2e": "playwright test",
    "eval:compaction": "MEDBUDDY_RUN_COMPACTION_EVAL=true vitest run --run --testTimeout=60000 compaction-eval",
    "test:vertex-smoke": "MEDBUDDY_RUN_VERTEX_SMOKE=true vitest run --run --testTimeout=60000 vertex-smoke"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "10.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
